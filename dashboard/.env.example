BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Supabase (data layer). URL and publishable key are safe for the browser.
# The service_role key is server-only (bypasses RLS) — never expose it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

HOME_PATHNAME=/applications
NEXT_PUBLIC_HOME_PATHNAME=/applications

# Gmail OAuth (create credentials at console.cloud.google.com, enable Gmail API)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
